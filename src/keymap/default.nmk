{
  "nmk": 1,
  "name": "Default",
  "extends": "none",
  "keyboard": {
    "key:ArrowUp": "up",
    "key:ArrowDown": "down",
    "key:ArrowLeft": "left",
    "key:ArrowRight": "right",
    "key:Enter": "ok",
    "key: ": "ok",
    "key:Backspace": "backspace",
    "key:Escape": "back",
    "key:Home": "home",
    "key:Shift": "shift",
    "key:Control": "alpha",
    "key:0": "zero",
    "key:1": "one",
    "key:2": "two",
    "key:3": "three",
    "key:4": "four",
    "key:5": "five",
    "key:6": "six",
    "key:7": "seven",
    "key:8": "eight",
    "key:9": "nine",
    "key:+": "plus",
    "key:-": "minus",
    "key:*": "multiplication",
    "key:/": "division",
    "key:.": "dot",
    "key:,": "comma",
    "key:(": "left_parenthesis",
    "key:)": "right_parenthesis",
    "key:e": "exe"
  },
  "touch": {
    "rules": [
      { "gesture": "swipe_left", "key": "left" },
      { "gesture": "swipe_right", "key": "right" },
      { "gesture": "swipe_up", "key": "up" },
      { "gesture": "swipe_down", "key": "down" },
      { "gesture": "tap", "key": "ok" },
      { "gesture": "u_turn", "key": "back" }
    ]
  }
}
